	<section class="page-section" id="info">
		<div class="container">
			<h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Info</h2>
			<div class="divider-custom">
				<div class="divider-custom-line"></div>
				<div class="divider-custom-icon"><i class="fas fa-sun"></i></div>
				<div class="divider-custom-line"></div>
			</div>
			<div class="row">
				<div class="col-lg-4 ml-auto wow animate__animated animate__slideInLeft">
					<p><i class="fas fa-server"></i> Server:</p>
				</div>
				<div class="col-lg-4 mr-auto wow animate__animated animate__slideInRight">
					<p>mc.nucilandia.ro</p>
				</div>
			</div>
			<div class="row">
				<div class="col-lg-4 ml-auto wow animate__animated animate__slideInLeft">
					<p><i class="fas fa-users"></i> Jucători online:</p>
				</div>
				<div class="col-lg-4 mr-auto wow animate__animated animate__slideInRight">
					<p id="server-players">—</p>
				</div>
			</div>
			<div class="row">
				<div class="col-lg-4 ml-auto wow animate__animated animate__slideInLeft">
					<p><i class="fas fa-brands fa-discord"></i> Discord:</p>
				</div>
				<div class="col-lg-4 mr-auto wow animate__animated animate__slideInRight">
					<p><a class="portfolio-item mx-auto" data-toggle="modal" data-target="#modalDiscord">NuciLandia</a></p>
				</div>
			</div>
			<div class="row">
				<div class="col-lg-4 ml-auto wow animate__animated animate__slideInLeft">
					<p><i class="fa-solid fa-earth-europe"></i> Harta Lumii:</p>
				</div>
				<div class="col-lg-4 mr-auto wow animate__animated animate__slideInRight">
					<p><a href="https://mc.nucilandia.ro/nucicraft/webmap/" target="_blank">https://mc.nucilandia.ro/nucicraft/webmap/</a></p>
				</div>
			</div>
			<div class="row">
				<div class="col-lg-4 ml-auto wow animate__animated animate__slideInLeft">
					<p><i class="fa-solid fa-gift"></i> Donații:</p>
				</div>
				<div class="col-lg-4 mr-auto wow animate__animated animate__slideInRight">
					<p><a href="https://hmlendea.go.ro/funding" target="_blank">https://hmlendea.go.ro/funding</a></p>
				</div>
			</div>
			<div class="row">
				<div class="col-lg-4 ml-auto wow animate__animated animate__slideInLeft">
					<p><i class="fa-solid fa-gamepad"></i> Minecraft Launcher:</p>
				</div>
