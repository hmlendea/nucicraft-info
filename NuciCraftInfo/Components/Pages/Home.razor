				</div>
			</div>
			<div class="row">
				<div class="col-lg-4 ml-auto wow animate__animated animate__slideInLeft">
					<p><i class="fa-solid fa-shirt"></i> Skins:</p>
				</div>
				<div class="col-lg-4 mr-auto wow animate__animated animate__slideInRight">
