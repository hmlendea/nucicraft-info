	<header class="masthead bg-primary text-white text-center">
		<div class="container d-flex align-items-center flex-column">
			<img class="masthead-avatar mb-5 wow animate__animated animate__bounceIn" src="https://raw.githubusercontent.com/hmlendea/nucilandia/master/Coat%20of%20Arms/Coat%20of%20Arms.svg" alt="NuciCraft" />
			<span class="skills">
				<p class="text-center typewrite" data-period="2000" data-type='[ "Minecraft server", "Definitely not a cult", "Trolls", "We love buckets", "In Ciupitu we trust!", "Poți fugi dar nu te poți ascunde", "Am descoperit Găletida!" ]'>
					<span class="wrap"></span>
				</p>
			</span>
		</div>
